{
    "name": "Funny Jokes & More",
    "version": "1.0.0",
    "description": "Get instant laughs with dad jokes, pickup lines, puns, and more! Your daily dose of humor in one click.",
    "manifest_version": 3,
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "logo.png",
            "48": "logo.png",
            "128": "logo.png"
        }
    },
    "icons": {
        "16": "logo.png",
        "48": "logo.png",
        "128": "logo.png"
    },
    "permissions": [
        "activeTab"
    ],
    "host_permissions": [
        "https://icanhazdadjoke.com/*",
        "https://api.quotable.io/*",
        "https://official-joke-api.appspot.com/*"
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'"
    },
    "author": "AkshatNaruka",
    "homepage_url": "https://github.com/AkshatNaruka/Dad-jokes-chrome-extension"
}